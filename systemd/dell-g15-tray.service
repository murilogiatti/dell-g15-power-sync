[Unit]
Description=Dell G15 System Tray Widget & Control Center
After=graphical-session.target dell-g15-daemon.service
Requisite=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=|WAYLAND_DISPLAY
ConditionEnvironment=|DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/g15-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
