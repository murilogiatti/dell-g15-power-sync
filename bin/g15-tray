#!/usr/bin/env python3
"""
Dell G15 System Tray & Control Center — Desktop-Aware Launcher (`g15-tray`).
Detects the session desktop (`XDG_CURRENT_DESKTOP`, `DESKTOP_SESSION`, `KDE_FULL_SESSION`,
or explicit `--backend gtk|qt` / `G15_UI_BACKEND=gtk|qt`) and imports ONLY the selected
toolkit (`g15_gtk` for GNOME/GTK4/Libadwaita, or `g15_qt` for KDE Plasma/Qt6/Kirigami).
"""

import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

import g15_core as core  # noqa: E402
from g15_core import (  # noqa: E402, F401
    ASSETS_DIR,
    BACKLIGHT_KEYCODES,
    BACKLIGHT_SCANCODES,
    BRIGHTNESS_STEPS,
    COLOR_PRESETS,
    CONFIG_DIR,
    CONFIG_PATH,
    DATA_DIR,
    DEFAULT_CONFIG,
    EFFECT_MODES,
    EV_KEY,
    EV_MSC,
    GITHUB_API_COMMITS_URL,
    GITHUB_RAW_REPO_URL,
    GITHUB_REPO,
    GMODE_KEYCODES,
    GMODE_SCANCODES,
    INPUT_EVENT_STRUCT,
    IS_PT,
    MSC_SCAN,
    POWER_PROFILES,
    REPO_ASSETS_DIR,
    UPDATE_FILES_MAP,
    VALID_MODES,
    VERSION_FILE,
    apply_backlight_cycle,
    apply_brightness_step,
    apply_g_mode_transition,
    detect_desktop_backend,
    discover_evdev_hotkey_nodes,
    evaluate_boot_save_feedback,
    fetch_latest_github_commit,
    format_detailed_telemetry_label,
    format_missing_backend_instructions,
    format_telemetry_label,
    get_power_profile,
    is_commit_same_or_ahead,
    load_config,
    normalize_config,
    parse_backend_override,
    read_local_version,
    read_telemetry,
    request_boot_save,
    restart_systemd_services,
    save_config,
    set_power_profile,
    stage_and_apply_update,
    tr,
    write_local_version,
)


def load_ui_backend(backend_name):
    """
    Imports ONLY the requested UI backend module ('gtk' -> `g15_gtk`, 'qt' -> `g15_qt`).
    Never falls back to the other toolkit if dependencies are missing; instead raises
    RuntimeError with clear, distribution-specific installation instructions.
    """
    if backend_name == "gtk":
        try:
            import g15_gtk

            return g15_gtk
        except (ImportError, ValueError) as exc:
            raise RuntimeError(
                format_missing_backend_instructions("gtk", detail=str(exc))
            ) from exc

    if backend_name == "qt":
        try:
            import g15_qt

            return g15_qt
        except (ImportError, ValueError) as exc:
            raise RuntimeError(
                format_missing_backend_instructions("qt", detail=str(exc))
            ) from exc

    raise ValueError(
        tr(
            f"Backend desconhecido '{backend_name}'. Valores válidos: 'gtk' ou 'qt'.",
            f"Unknown backend '{backend_name}'. Valid values: 'gtk' or 'qt'.",
        )
    )


def main(argv=None):
    raw_argv = list(sys.argv if argv is None else argv)
    try:
        backend, clean_argv = parse_backend_override(raw_argv)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    if "--diagnose" in clean_argv:
        import json
        print(json.dumps(core.probe_system_capabilities(), indent=2))
        return 0
    if "--check-dependencies" in clean_argv:
        ok, status, message = core.check_backend_dependencies(backend)
        print(f"{status}: {message}")
        return 0 if ok else 1
    # Explicit headless actions never load a graphical toolkit.
    if "--headless" in clean_argv:
        cfg = core.load_config()
        if "--toggle-gmode" in clean_argv:
            _changed, _profile, title, body = core.apply_g_mode_transition(cfg)
        elif "--cycle-backlight" in clean_argv:
            title, body = core.apply_backlight_cycle(cfg)
        else:
            print("Use --headless with --toggle-gmode or --cycle-backlight", file=sys.stderr)
            return 2
        print(f"{title}: {body}")
        return 0
    if "--print-backend" in clean_argv:
        print(backend)
        return 0

    try:
        backend_mod = load_ui_backend(backend)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    try:
        if backend == "gtk":
            return backend_mod.run_gtk_app(clean_argv)
        return backend_mod.run_qt_app(clean_argv)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
