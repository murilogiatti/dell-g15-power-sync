#!/usr/bin/env python3
"""
Dell G15 System Tray Indicator & GTK4/Libadwaita Control Center.
Zero extra dependencies (uses system PyGObject: Gio, GLib, Gtk 4.0, Adw 1).
Data-Oriented Design: flat lookup tables for presets, effects, brightness tiers, and sensors.
"""

import glob
import json
import os
import signal
import sys
import warnings

import gi

warnings.filterwarnings("ignore", category=DeprecationWarning)
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

# --- Configuration Paths & Defaults ---
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "dell-g15"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")

DEFAULT_CONFIG = {
    "sync_screen": True,
    "manual_brightness": 100,
    "mode": "static",
    "speed": 150,
    "per_zone": False,
    "zones_rgb": ["E6E6E6", "E6E6E6", "E6E6E6", "E6E6E6"],
    "zones_rgb2": ["00E5FF", "00E5FF", "00E5FF", "00E5FF"],
    "power_cap": True,
    "save_boot": False,
}

# --- Data-Oriented Lookup Tables ---
BRIGHTNESS_STEPS = (0, 10, 30, 50, 75, 100)

# (id_code, hex_rgb, label_pt, label_en)
COLOR_PRESETS = (
    ("white", "E6E6E6", "⚪ Branco Puro (#E6E6E6)", "⚪ Pure White (#E6E6E6)"),
    ("amber", "FFB366", "🟠 Âmbar Conforto (#FFB366)", "🟠 Warm Amber (#FFB366)"),
    ("cyan", "00E5FF", "🔵 Ciano Alienware (#00E5FF)", "🔵 Alienware Cyan (#00E5FF)"),
    ("red", "FF2200", "🔴 Vermelho G15 (#FF2200)", "🔴 G15 Red (#FF2200)"),
    ("green", "00E676", "🟢 Verde Matrix (#00E676)", "🟢 Matrix Green (#00E676)"),
    ("purple", "B388FF", "🟣 Roxo Neon (#B388FF)", "🟣 Neon Purple (#B388FF)"),
)

# (mode_key, label_pt, label_en)
EFFECT_MODES = (
    ("static", "Estático (Static)", "Static"),
    ("breathing", "Respiração (Breathing)", "Breathing"),
    ("pulse", "Pulso (Pulse)", "Pulse"),
    ("morph", "Transição 2 Cores (Morph)", "Two-Color Morph"),
    ("spectrum", "Ciclo de Cores (Spectrum)", "Spectrum Cycle"),
    ("rainbow", "Ondas Arco-Íris (Rainbow)", "Rainbow Wave"),
)

# (profile_id, label_pt, label_en)
POWER_PROFILES = (
    ("power-saver", "🌱 Economia de Energia", "🌱 Power Saver"),
    ("balanced", "⚖️ Equilibrado (Balanced)", "⚖️ Balanced"),
    ("performance", "🚀 Desempenho (G-Mode)", "🚀 Performance (G-Mode)"),
)

IS_PT = os.environ.get("LANG", "").lower().startswith("pt")


def tr(pt_str, en_str):
    return pt_str if IS_PT else en_str


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    cfg["zones_rgb"] = list(DEFAULT_CONFIG["zones_rgb"])
    cfg["zones_rgb2"] = list(DEFAULT_CONFIG["zones_rgb2"])
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            raw = json.load(f)
        if isinstance(raw, dict):
            for k in DEFAULT_CONFIG:
                if k in raw:
                    cfg[k] = raw[k]
    except (OSError, ValueError):
        pass

    for key, fallback in (("zones_rgb", "E6E6E6"), ("zones_rgb2", "00E5FF")):
        arr = cfg.get(key)
        if not isinstance(arr, list) or len(arr) < 4:
            cfg[key] = [fallback] * 4
        else:
            cfg[key] = [str(x).lstrip("#").upper()[:6] or fallback for x in arr[:4]]
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp_path = f"{CONFIG_PATH}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp_path, CONFIG_PATH)


def hex_to_rgba(hex_str):
    clean = str(hex_str).lstrip("#").strip()
    rgba = Gdk.RGBA()
    if not rgba.parse(f"#{clean}"):
        rgba.parse("#E6E6E6")
    return rgba


def rgba_to_hex(rgba):
    r = max(0, min(255, int(round(rgba.red * 255))))
    g = max(0, min(255, int(round(rgba.green * 255))))
    b = max(0, min(255, int(round(rgba.blue * 255))))
    return f"{r:02X}{g:02X}{b:02X}"


# --- Flat Hardware Telemetry Reader (/sys/class/hwmon + UPower PowerProfiles) ---
def read_telemetry():
    """Returns flat dict: cpu_c, gpu_c, nvme_c, fan1_rpm, fan2_rpm."""
    data = {"cpu_c": 0, "gpu_c": 0, "nvme_c": 0, "fan1_rpm": 0, "fan2_rpm": 0}
    for hw_dir in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(hw_dir, "name"), "r", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            continue

        if name in ("k10temp", "coretemp"):
            try:
                with open(os.path.join(hw_dir, "temp1_input"), "r", encoding="utf-8") as f:
                    data["cpu_c"] = int(f.read().strip()) // 1000
            except (OSError, ValueError):
                pass
        elif name == "amdgpu" and data["gpu_c"] == 0:
            try:
                with open(os.path.join(hw_dir, "temp1_input"), "r", encoding="utf-8") as f:
                    data["gpu_c"] = int(f.read().strip()) // 1000
            except (OSError, ValueError):
                pass
        elif name == "nvme" and data["nvme_c"] == 0:
            try:
                with open(os.path.join(hw_dir, "temp1_input"), "r", encoding="utf-8") as f:
                    data["nvme_c"] = int(f.read().strip()) // 1000
            except (OSError, ValueError):
                pass
        elif name in ("alienware_wmi", "dell_smm"):
            for idx, key in ((1, "fan1_rpm"), (2, "fan2_rpm")):
                try:
                    with open(
                        os.path.join(hw_dir, f"fan{idx}_input"), "r", encoding="utf-8"
                    ) as f:
                        val = int(f.read().strip())
                        if val >= 0:
                            data[key] = val
                except (OSError, ValueError):
                    pass
    return data


def get_power_profile():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        res = bus.call_sync(
            "org.freedesktop.UPower.PowerProfiles",
            "/org/freedesktop/UPower/PowerProfiles",
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", ("org.freedesktop.UPower.PowerProfiles", "ActiveProfile")),
            GLib.VariantType("(v)"),
            Gio.DBusCallFlags.NONE,
            1000,
            None,
        )
        return res.unpack()[0]
    except Exception:
        return "balanced"


def set_power_profile(profile_name):
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        bus.call_sync(
            "org.freedesktop.UPower.PowerProfiles",
            "/org/freedesktop/UPower/PowerProfiles",
            "org.freedesktop.DBus.Properties",
            "Set",
            GLib.Variant(
                "(ssv)",
                (
                    "org.freedesktop.UPower.PowerProfiles",
                    "ActiveProfile",
                    GLib.Variant("s", profile_name),
                ),
            ),
            None,
            Gio.DBusCallFlags.NONE,
            1500,
            None,
        )
        return True
    except Exception:
        return False


# --- StatusNotifierItem + Dbusmenu XML Specifications ---
SNI_NODE_INFO = Gio.DBusNodeInfo.new_for_xml(
    """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="i" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconAccessibleDesc" type="s" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="AttentionAccessibleDesc" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="XAyatanaLabel" type="s" access="read"/>
    <property name="XAyatanaLabelGuide" type="s" access="read"/>
    <property name="XAyatanaOrderingIndex" type="u" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <method name="Activate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="SecondaryActivate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="ContextMenu">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="Scroll">
      <arg name="delta" type="i" direction="in"/>
      <arg name="orientation" type="s" direction="in"/>
    </method>
    <signal name="NewTitle"/>
    <signal name="NewIcon"/>
    <signal name="NewStatus">
      <arg name="status" type="s"/>
    </signal>
    <signal name="NewToolTip"/>
    <signal name="XAyatanaNewLabel">
      <arg name="label" type="s"/>
      <arg name="guide" type="s"/>
    </signal>
  </interface>
</node>
"""
)

DBUSMENU_NODE_INFO = Gio.DBusNodeInfo.new_for_xml(
    """
<node>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg type="i" name="parentId" direction="in"/>
      <arg type="i" name="recursionDepth" direction="in"/>
      <arg type="as" name="propertyNames" direction="in"/>
      <arg type="u" name="revision" direction="out"/>
      <arg type="(ia{sv}av)" name="layout" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg type="ai" name="ids" direction="in"/>
      <arg type="as" name="propertyNames" direction="in"/>
      <arg type="a(ia{sv})" name="properties" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg type="i" name="id" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="v" name="value" direction="out"/>
    </method>
    <method name="Event">
      <arg type="i" name="id" direction="in"/>
      <arg type="s" name="eventId" direction="in"/>
      <arg type="v" name="data" direction="in"/>
      <arg type="u" name="timestamp" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg type="a(isvu)" name="events" direction="in"/>
