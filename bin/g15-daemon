#!/usr/bin/env python3
"""
Dell G15 Ambient Sync Daemon (Direct USB HID + Kernel Netlink / Inotify Events)
Zero external dependencies. Data-Oriented Design (flat tables, pre-allocated buffers).
Compatible with Ubuntu/Debian and Fedora Workstation/Kinoite (Atomic).
"""

import ctypes
import ctypes.util
import fcntl
import glob
import contextlib
import json
import math
import os
import select
import signal
import socket
import struct
import sys
import time

# --- Hardware & Protocol Constants (Alienware AW-ELC 187c:0550 / 187c:0551) ---
TARGET_HID_IDS = ("187C:00000550", "187C:00000551")
REPORT_SIZE = 34
HIDIOCSFEATURE_34 = 0xC0004806 | (REPORT_SIZE << 16)
HIDIOCGFEATURE_34 = 0xC0004807 | (REPORT_SIZE << 16)
PACKET_DELAY_SEC = 0.05
DEBOUNCE_SEC = 0.15
NETLINK_KOBJECT_UEVENT = 15

SLOT_VOLATILE = 0xFFFF
SLOT_BOOT_DEFAULT = 0x0061
DURATION_STATIC = 0x07D0
DURATION_SPECTRUM = 0x01AC
TEMPO_MAX = 0x00FA

# Inotify constants for direct sysfs & config file watching
IN_MODIFY = 0x00000002
IN_ATTRIB = 0x00000004
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_UNMOUNT = 0x00002000
IN_IGNORED = 0x00008000
IN_NONBLOCK = 0x00000800
IN_CLOEXEC = 0x00080000
INOTIFY_EVENT_HDR = struct.Struct("iIII")

# Platform IDs zone mapping table (matching OpenRGB's AlienwareController)
PLATFORM_ZONES = {
    0x0C01: (0x00, 0x01, 0x02, 0x03),  # Dell G5 SE 5505
    0x0E03: (0x00, 0x01, 0x02, 0x03),  # Dell G15 5511
    0x0E07: (0x10, 0x11, 0x12, 0x13),  # Dell G15 5520
    0x0E0A: (0x10, 0x11, 0x12, 0x13),  # Dell G15 5530
}
ZONES_DEFAULT_16 = tuple(range(16))

# --- Data-Oriented Brightness & Hysteresis Tables (SoA) ---
# 5 active intensity tiers + 0 for DPMS Screen Off.
# Peak capped at 230 (0xE6 -> #E6E6E6) to prevent hardware power limiter drops.
ZONE_LEVELS = (10, 30, 50, 75, 100)
ZONE_RGB_BYTES = (0x17, 0x45, 0x73, 0xAC, 0xE6)
ZONE_THRESHOLDS = (20, 40, 60, 80)
HYSTERESIS = 2

# 7-step Rainbow / Spectrum table (R, G, B)
RAINBOW_STEPS = (
    (255, 0, 0),
    (255, 165, 0),
    (255, 255, 0),
    (0, 128, 0),
    (0, 191, 255),
    (0, 0, 255),
    (128, 0, 128),
)

VALID_MODES = ("static", "breathing", "pulse", "morph", "spectrum", "rainbow")

DEFAULT_CONFIG = {
    "sync_screen": True,
    "manual_brightness": 100,
    "mode": "static",
    "speed": 40,
    "per_zone": False,
    "zones_rgb": ["E6E6E6", "E6E6E6", "E6E6E6", "E6E6E6"],
    "zones_rgb2": ["00E5FF", "00E5FF", "00E5FF", "00E5FF"],
    "power_cap": True,
    "save_boot": False,
    "save_boot_seq": 0,
    "save_boot_status": None,
    "g_mode": False,
    "pre_gmode": None,
    "force_seq": 0,
}

# Configurable roots (overridable in unit tests)
SYSFS_BACKLIGHT_ROOT = "/sys/class/backlight"
SYSFS_HIDRAW_ROOT = "/sys/class/hidraw"
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "dell-g15"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")


def _sanitize_hex_color(val, fallback):
    clean = str(val or "").lstrip("#").strip().upper()
    if len(clean) == 6 and all(c in "0123456789ABCDEF" for c in clean):
        try:
            int(clean, 16)
            return clean
        except ValueError:
            pass
    return fallback


def _safe_int(val, default, min_val=None, max_val=None):
    if isinstance(val, bool) or val is None:
        res = default
    elif isinstance(val, int):
        res = val
    elif isinstance(val, float):
        if not math.isfinite(val):
            res = default
        else:
            res = int(val)
    elif isinstance(val, str):
        s = val.strip()
        if not s:
            res = default
        else:
            try:
                res = int(s)
            except ValueError:
                try:
                    f = float(s)
                    res = int(f) if math.isfinite(f) else default
                except (ValueError, OverflowError):
                    res = default
    else:
        res = default
    if min_val is not None:
        res = max(min_val, res)
    if max_val is not None:
        res = min(max_val, res)
    return res


def normalize_config(raw):
    cfg = dict(DEFAULT_CONFIG)
    cfg["zones_rgb"] = list(DEFAULT_CONFIG["zones_rgb"])
    cfg["zones_rgb2"] = list(DEFAULT_CONFIG["zones_rgb2"])
    if not isinstance(raw, dict):
        return cfg

    for bool_key in ("sync_screen", "per_zone", "power_cap", "save_boot", "g_mode"):
        if isinstance(raw.get(bool_key), bool):
            cfg[bool_key] = raw[bool_key]

    cfg["manual_brightness"] = _safe_int(raw.get("manual_brightness"), 100, 0, 100)
    cfg["speed"] = _safe_int(raw.get("speed"), 40, 10, 100)
    cfg["force_seq"] = _safe_int(raw.get("force_seq"), 0, 0, 2_000_000_000)

    cfg["save_boot_seq"] = _safe_int(raw.get("save_boot_seq"), 0, 0, 9_223_372_036_854_775_807)

    raw_mode = raw.get("mode")
    if isinstance(raw_mode, str) and raw_mode.strip().lower() in VALID_MODES:
        cfg["mode"] = raw_mode.strip().lower()

    for key, fallback in (("zones_rgb", "E6E6E6"), ("zones_rgb2", "00E5FF")):
        arr = raw.get(key)
        if isinstance(arr, list) and len(arr) >= 4:
            cfg[key] = [_sanitize_hex_color(x, fallback) for x in arr[:4]]
        else:
            cfg[key] = [fallback] * 4

    pre = raw.get("pre_gmode")
    if isinstance(pre, dict):
        pre_mode = str(pre.get("mode", "static")).strip().lower()
        if pre_mode not in VALID_MODES:
            pre_mode = "static"
        pre_zones = pre.get("zones_rgb")
        if isinstance(pre_zones, list) and len(pre_zones) >= 4:
            norm_pre_zones = [_sanitize_hex_color(x, "E6E6E6") for x in pre_zones[:4]]
        else:
            norm_pre_zones = list(DEFAULT_CONFIG["zones_rgb"])
        pre_prof = pre.get("power_profile")
        if not isinstance(pre_prof, str) or pre_prof not in (
            "power-saver",
            "balanced",
            "performance",
        ):
            pre_prof = "balanced"
        cfg["pre_gmode"] = {
            "mode": pre_mode,
            "per_zone": bool(pre.get("per_zone", False))
            if isinstance(pre.get("per_zone"), bool)
            else False,
            "zones_rgb": norm_pre_zones,
            "power_profile": pre_prof,
        }
    else:
        cfg["pre_gmode"] = None

    sbs = raw.get("save_boot_status")
    if isinstance(sbs, dict):
        state = str(sbs.get("state", "")).strip().lower()
        ok_val = sbs.get("ok")
        if state in ("running", "done") or isinstance(ok_val, bool):
            if state not in ("running", "done"):
                state = "done"
            cfg["save_boot_status"] = {
                "seq": _safe_int(sbs.get("seq"), 0, 0, 9_223_372_036_854_775_807),
                "state": state,
                "ok": bool(ok_val) if isinstance(ok_val, bool) else None,
            }
        else:
            cfg["save_boot_status"] = None
    else:
        cfg["save_boot_status"] = None

    return cfg


def load_config(path=None):
    cfg_path = path or CONFIG_PATH
    raw = None
    try:
        with open(cfg_path, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        pass
    return normalize_config(raw)


def _write_config(cfg, path=None):
    cfg_path = path or CONFIG_PATH
    cfg_dir = os.path.dirname(cfg_path)
    os.makedirs(cfg_dir, exist_ok=True)
    tmp_path = f"{cfg_path}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp_path, cfg_path)


@contextlib.contextmanager
def config_lock(path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def save_config(cfg, path=None):
    cfg_path = path or CONFIG_PATH
    with config_lock(cfg_path):
        _write_config(cfg, cfg_path)


def parse_hex_rgb(hex_str, power_cap=True):
    clean = str(hex_str).lstrip("#").strip()
    if len(clean) != 6:
        r, g, b = 230, 230, 230
    else:
        try:
            r = int(clean[0:2], 16)
            g = int(clean[2:4], 16)
            b = int(clean[4:6], 16)
        except ValueError:
            r, g, b = 230, 230, 230
    if power_cap:
        r = min(r, 230)
        g = min(g, 230)
        b = min(b, 230)
    return r, g, b


def scale_rgb(rgb_tuple, scale_perc):
    r, g, b = rgb_tuple
    s = max(0, min(100, int(scale_perc)))
    return (r * s) // 100, (g * s) // 100, (b * s) // 100


def resolve_backlight_dir(backlight_root=None):
    root = backlight_root or SYSFS_BACKLIGHT_ROOT
    preferred = os.path.join(root, "amdgpu_bl2")
    if os.path.isdir(preferred):
        return preferred
    for pattern in ("amdgpu_bl*", "*"):
        for candidate in sorted(glob.glob(os.path.join(root, pattern))):
            if os.path.isdir(candidate):
                return candidate
    return None


def resolve_hidraw_dev(hidraw_root=None):
    root = hidraw_root or SYSFS_HIDRAW_ROOT
    for sys_path in sorted(glob.glob(os.path.join(root, "hidraw*"))):
        uevent_path = os.path.join(sys_path, "device", "uevent")
        try:
            with open(uevent_path, "r", encoding="utf-8") as f:
                content = f.read().upper()
            if any(hid_id in content for hid_id in TARGET_HID_IDS):
                return os.path.join("/dev", os.path.basename(sys_path))
        except OSError:
            continue
    return None


def read_int_file(path, default=0):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return default


def read_screen_state(backlight_dir):
    """Returns (brightness_perc: int, screen_on: bool)."""
    if not backlight_dir or not os.path.isdir(backlight_dir):
        return 100, True

    bl_power = read_int_file(os.path.join(backlight_dir, "bl_power"), default=0)
    curr = read_int_file(os.path.join(backlight_dir, "brightness"), default=100)
    max_val = read_int_file(os.path.join(backlight_dir, "max_brightness"), default=100)

    if max_val <= 0:
        return 100, True

    perc = (curr * 100) // max_val
    screen_on = bl_power == 0
    return perc, screen_on


def compute_target_zone(brightness_perc, screen_on, current_zone):
    """Maps screen brightness to target keyboard zone (0, 10, 30, 50, 75, 100) with ±2% hysteresis."""
    if not screen_on:
        return 0

    if current_zone in ZONE_LEVELS:
        idx = ZONE_LEVELS.index(current_zone)
        while idx < 4 and brightness_perc > (ZONE_THRESHOLDS[idx] + HYSTERESIS):
            idx += 1
        while idx > 0 and brightness_perc <= (ZONE_THRESHOLDS[idx - 1] - HYSTERESIS):
            idx -= 1
        return ZONE_LEVELS[idx]

    for i, threshold in enumerate(ZONE_THRESHOLDS):
        if brightness_perc <= threshold:
            return ZONE_LEVELS[i]
    return ZONE_LEVELS[4]


def build_packet(cmd_bytes):
    """Builds a 34-byte HID Feature report (byte 0 = 0x00, byte 1 = 0x03)."""
    buf = bytearray(REPORT_SIZE)
    buf[0] = 0x00
    buf[1] = 0x03
    for i, b in enumerate(cmd_bytes):
        buf[2 + i] = b
    return buf


def build_mode_action_packet(actions):
    """
    Packs 1 to 3 mode action blocks into a single 0x24 ADD_ACTION report.
    Each item in actions is (mode_byte, duration_u16, tempo_u16, r, g, b).
    """
    payload = [0x24]
    for mode_b, dur, tempo, r, g, b in actions[:3]:
        payload.extend(
            (
                mode_b,
                (dur >> 8) & 0xFF,
                dur & 0xFF,
                (tempo >> 8) & 0xFF,
                tempo & 0xFF,
                r & 0xFF,
                g & 0xFF,
                b & 0xFF,
            )
        )
    return build_packet(payload)


def compute_anim_timing(mode, speed_perc):
    """
    Maps user speed percentage (10..100, where 10=slowest/calmest and 100=fastest)
    to hardware (duration_ms, tempo) for the AW-ELC controller.
    In AW-ELC firmware, LARGER duration/tempo values produce SLOWER transitions.
    """
    s = max(10, min(100, int(speed_perc)))
    t_norm = (s - 10) / 90.0
    if mode in ("spectrum", "rainbow"):
        duration = int(round(2500 - t_norm * (2500 - DURATION_SPECTRUM)))
        tempo = int(round(250 - t_norm * (250 - 25)))
    else:
        tempo = int(round(450 - t_norm * (450 - 50)))
        duration = tempo * 10
    return duration, tempo


def build_zone_packets(zone_level, zone_ids=ZONES_DEFAULT_16, config=None, save_boot=False):
    """
    Builds the 34-byte HID Feature report sequence for the AW-ELC controller.
    Supports per-zone RGB, brightness scaling, hardware animations, and EEPROM boot save.
    """
    cfg = config or DEFAULT_CONFIG
    num_zones = len(zone_ids)

    if zone_level <= 0 and not save_boot:
        return [build_packet((0x26, 100, 0x00, num_zones, *zone_ids))]

    eff_level = max(0, min(100, int(zone_level)))
    power_cap = bool(cfg.get("power_cap", True))
    per_zone = bool(cfg.get("per_zone", False))
    mode = str(cfg.get("mode", "static")).lower()
    speed = max(10, min(100, int(cfg.get("speed", 40))))
    anim_duration, anim_tempo = compute_anim_timing(mode, speed)

    zones_hex1 = cfg.get("zones_rgb", DEFAULT_CONFIG["zones_rgb"])
    zones_hex2 = cfg.get("zones_rgb2", DEFAULT_CONFIG["zones_rgb2"])

    rgb1_table = [
        scale_rgb(parse_hex_rgb(zones_hex1[i % len(zones_hex1)], power_cap), eff_level)
        for i in range(4)
    ]
    rgb2_table = [
        scale_rgb(parse_hex_rgb(zones_hex2[i % len(zones_hex2)], power_cap), eff_level)
        for i in range(4)
    ]

    slot = SLOT_BOOT_DEFAULT if save_boot else SLOT_VOLATILE
    slot_hi, slot_lo = (slot >> 8) & 0xFF, slot & 0xFF

    packets = [
        build_packet((0x26, 0x00, 0x00, num_zones, *zone_ids)),
    ]
    if save_boot:
        packets.append(build_packet((0x21, 0x00, 0x04, slot_hi, slot_lo, 0x00, 0x00)))
    packets.append(build_packet((0x21, 0x00, 0x01, slot_hi, slot_lo, 0x00, 0x00)))

    for idx, hw_zone in enumerate(zone_ids):
        logical_idx = (idx % 4) if per_zone else 0
        r1, g1, b1 = rgb1_table[logical_idx]
        r2, g2, b2 = rgb2_table[logical_idx]

        packets.append(build_packet((0x23, 0x01, 0x00, 0x01, hw_zone)))

        if mode == "pulse":
            packets.append(
                build_mode_action_packet([(0x01, anim_duration, anim_tempo, r1, g1, b1)])
            )
        elif mode == "breathing":
            packets.append(
                build_mode_action_packet(
                    [
                        (0x02, anim_duration, anim_tempo, r1, g1, b1),
                        (0x02, anim_duration, anim_tempo, 0, 0, 0),
                    ]
                )
            )
        elif mode == "morph":
            packets.append(
                build_mode_action_packet(
                    [
                        (0x02, anim_duration, anim_tempo, r1, g1, b1),
                        (0x02, anim_duration, anim_tempo, r2, g2, b2),
                    ]
                )
            )
        elif mode in ("spectrum", "rainbow"):
            offset = (idx % 4) if mode == "rainbow" else 0
            steps = []
            for s_i in range(7):
                base_rgb = RAINBOW_STEPS[(s_i + offset) % 7]
                if power_cap:
                    base_rgb = (
                        min(base_rgb[0], 230),
                        min(base_rgb[1], 230),
                        min(base_rgb[2], 230),
                    )
                sr, sg, sb = scale_rgb(base_rgb, eff_level)
                steps.append((0x02, anim_duration, anim_tempo, sr, sg, sb))
            packets.append(build_mode_action_packet(steps[0:3]))
            packets.append(build_mode_action_packet(steps[3:6]))
            packets.append(build_mode_action_packet(steps[6:7]))
        else:
            # Default: Static color (0x00)
            packets.append(
                build_mode_action_packet(
                    [(0x00, DURATION_STATIC, TEMPO_MAX, r1, g1, b1)]
                )
            )

    if save_boot:
        packets.append(build_packet((0x21, 0x00, 0x02, slot_hi, slot_lo, 0x00, 0x00)))
        packets.append(build_packet((0x21, 0x00, 0x06, slot_hi, slot_lo, 0x00, 0x00)))
        packets.append(build_packet((0x21, 0x00, 0x07, slot_hi, slot_lo, 0x00, 0x00)))
    else:
        packets.append(build_packet((0x21, 0x00, 0x03, slot_hi, slot_lo, 0x00, 0x00)))

    return packets


def send_hid_packet(fd, pkt, delay=PACKET_DELAY_SEC):
    fcntl.ioctl(fd, HIDIOCSFEATURE_34, pkt)
    if delay > 0:
        time.sleep(delay)
    resp = bytearray(REPORT_SIZE)
    fcntl.ioctl(fd, HIDIOCGFEATURE_34, resp)
    return resp


def detect_zone_ids(fd, delay=PACKET_DELAY_SEC):
    try:
        resp = send_hid_packet(fd, build_packet((0x20, 0x02)), delay=delay)
        send_hid_packet(fd, build_packet((0x20, 0x00)), delay=delay)
        if resp[1] == 0x03:
            platform_id = (resp[4] << 8) | resp[5]
            if platform_id in PLATFORM_ZONES:
                return PLATFORM_ZONES[platform_id]
            reported_count = resp[6]
            if 1 <= reported_count <= 25:
                return tuple(range(reported_count))
    except OSError:
        pass
    return ZONES_DEFAULT_16


def apply_zone_to_hardware(
    hidraw_path, zone_level, zone_ids=None, delay=PACKET_DELAY_SEC, config=None, save_boot=False
):
    if not hidraw_path or not os.path.exists(hidraw_path):
        return False, zone_ids

    fd = -1
    try:
        fd = os.open(hidraw_path, os.O_RDWR)
        if zone_ids is None:
            zone_ids = detect_zone_ids(fd, delay=delay)
        packets = build_zone_packets(zone_level, zone_ids, config=config, save_boot=save_boot)
        for pkt in packets:
            resp = send_hid_packet(fd, pkt, delay=delay)
            if resp[1] != 0x03:
                return False, zone_ids
        return True, zone_ids
    except OSError:
        return False, zone_ids
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass


def open_netlink_uevent_socket():
    sock = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, NETLINK_KOBJECT_UEVENT)
    sock.bind((0, 1))
    sock.setblocking(False)
    return sock


def open_inotify_watches(backlight_dir, config_dir=None, return_meta=False):
    cfg_dir = config_dir or CONFIG_DIR
    os.makedirs(cfg_dir, exist_ok=True)
    cfg_path = os.path.join(cfg_dir, "config.json")
    if not os.path.exists(cfg_path):
        try:
            save_config(DEFAULT_CONFIG, path=cfg_path)
        except OSError:
            pass
    meta = {
        "backlight_dir": backlight_dir,
        "backlight_wds": [],
        "config_wd": -1,
        "backlight_ok": False,
        "config_ok": False,
    }
    try:
        libc_name = ctypes.util.find_library("c") or "libc.so.6"
        libc = ctypes.CDLL(libc_name, use_errno=True)
        ifd = libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
        if ifd < 0:
            return (-1, meta) if return_meta else -1

        if backlight_dir and os.path.isdir(backlight_dir):
            bl_mask = (
                IN_MODIFY
                | IN_CLOSE_WRITE
                | IN_ATTRIB
                | IN_DELETE_SELF
                | IN_MOVE_SELF
            )
            for fname in ("brightness", "actual_brightness", "bl_power"):
                fpath = os.path.join(backlight_dir, fname)
                if not os.path.exists(fpath):
                    continue
                wd = libc.inotify_add_watch(ifd, fpath.encode("utf-8"), bl_mask)
                if wd >= 0:
                    meta["backlight_wds"].append(wd)
            dir_wd = libc.inotify_add_watch(
                ifd,
                backlight_dir.encode("utf-8"),
                IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF,
            )
            if dir_wd >= 0:
                meta["backlight_wds"].append(dir_wd)
            meta["backlight_ok"] = len(meta["backlight_wds"]) > 0

        cfg_wd = libc.inotify_add_watch(
            ifd, cfg_dir.encode("utf-8"), IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE
        )
        if cfg_wd >= 0:
            meta["config_wd"] = cfg_wd
            meta["config_ok"] = True
        else:
            try:
                os.close(ifd)
            except OSError:
                pass
            return (-1, meta) if return_meta else -1

        if backlight_dir and not meta["backlight_ok"]:
            print(f"Warning: no backlight watches registered for {backlight_dir}", file=sys.stderr, flush=True)
        return (ifd, meta) if return_meta else ifd
    except Exception:
        return (-1, meta) if return_meta else -1


def rebuild_inotify_watches(old_ifd, backlight_dir, config_dir=None, return_meta=False):
    if old_ifd >= 0:
        try:
            os.close(old_ifd)
        except OSError:
            pass
    return open_inotify_watches(
        backlight_dir, config_dir=config_dir, return_meta=return_meta
    )


def parse_inotify_events(raw_bytes):
    """
    Parses raw inotify_event structs and returns (events_list, watch_invalidated_bool).
    Each entry in events_list is (wd, mask, name).
    watch_invalidated_bool is True if any watch emitted IN_IGNORED, IN_DELETE_SELF,
    IN_MOVE_SELF, or IN_UNMOUNT.
    """
    events = []
    invalidated = False
    offset = 0
    hdr_size = INOTIFY_EVENT_HDR.size
    total = len(raw_bytes)
    inv_mask = IN_IGNORED | IN_DELETE_SELF | IN_MOVE_SELF | IN_UNMOUNT
    while offset + hdr_size <= total:
        wd, mask, _cookie, name_len = INOTIFY_EVENT_HDR.unpack_from(raw_bytes, offset)
        offset += hdr_size
        name_bytes = raw_bytes[offset : offset + name_len]
        offset += name_len
        name = name_bytes.rstrip(b"\x00").decode("utf-8", errors="ignore")
        events.append((wd, mask, name))
        if mask & inv_mask:
            invalidated = True
    return events, invalidated


def parse_relevant_uevent(raw_bytes):
    """Returns 'backlight_rebind', 'backlight', 'hidraw', or None from a kernel uevent datagram."""
    text = raw_bytes.decode("utf-8", errors="ignore")
    is_rebind_action = any(
        act in text
        for act in ("ACTION=add", "ACTION=remove", "ACTION=bind", "ACTION=unbind")
    )
    if "SUBSYSTEM=backlight" in text or "SUBSYSTEM=drm" in text:
        return "backlight_rebind" if is_rebind_action else "backlight"
    if "SUBSYSTEM=hidraw" in text:
        return "hidraw"
    return None


def compute_effective_state(cfg, perc, screen_on, current_auto_zone):
    if not screen_on:
        return 0, current_auto_zone
    if cfg.get("sync_screen", True):
        auto_zone = compute_target_zone(perc, screen_on, current_auto_zone)
        return auto_zone, auto_zone
    manual = max(0, min(100, int(cfg.get("manual_brightness", 100))))
    return manual, current_auto_zone


def make_state_signature(cfg, eff_level):
    return (
        eff_level,
        cfg.get("mode", "static"),
        cfg.get("speed", 40),
        cfg.get("per_zone", False),
        tuple(cfg.get("zones_rgb", ())),
        tuple(cfg.get("zones_rgb2", ())),
        cfg.get("power_cap", True),
        cfg.get("g_mode", False),
        cfg.get("force_seq", 0),
    )


def update_config_preserving_concurrent_edits(mutator_fn, path=None):
    """
    Re-reads the latest on-disk config immediately before saving, applies
    `mutator_fn(latest_cfg)` in-place, and atomically writes `latest_cfg` back.
    Prevents a long-running operation (such as a 5+ second boot EEPROM write)
    from overwriting user changes made while the hardware write was in progress.
    """
    cfg_path = path or CONFIG_PATH
    with config_lock(cfg_path):
        latest = load_config(cfg_path)
        mutator_fn(latest)
        _write_config(latest, cfg_path)
    return latest


def process_daemon_sync_step(
    state,
    pending_rebind=False,
    pending_bl_rebind=False,
    backlight_root=None,
    hidraw_root=None,
    config_dir=None,
    config_path=None,
    apply_hw_fn=None,
):
    """
    Executes a single consolidated daemon debounce step on `state` dict:
      - state keys: backlight_dir, hidraw_path, zone_ids, current_auto_zone,
                    last_sig, ifd, inotify_meta, sock
    Handles hidraw rebinding, backlight path re-resolution, inotify watch
    reconstruction (even when the recreated backlight uses the exact same path),
    concurrent-safe save_boot_status reporting, and hardware sync.
    """
    hw_apply = apply_hw_fn or apply_zone_to_hardware
    cfg_dir = config_dir or CONFIG_DIR
    cfg_file = config_path or os.path.join(cfg_dir, "config.json")

    if pending_rebind or not state.get("hidraw_path"):
        state["hidraw_path"] = resolve_hidraw_dev(hidraw_root)
        state["zone_ids"] = None
        state["last_sig"] = None

    old_bl = state.get("backlight_dir")
    resolved_bl = resolve_backlight_dir(backlight_root)
    bl_missing = bool(old_bl and not os.path.isdir(old_bl))
    meta = state.get("inotify_meta") or {}
    bl_watch_missing = bool(resolved_bl and not meta.get("backlight_ok", False))

    if (
        pending_bl_rebind
        or bl_missing
        or resolved_bl != old_bl
        or bl_watch_missing
        or state.get("ifd", -1) < 0
    ):
        state["backlight_dir"] = resolved_bl
        new_ifd, new_meta = rebuild_inotify_watches(
            state.get("ifd", -1),
            state["backlight_dir"],
            config_dir=cfg_dir,
            return_meta=True,
        )
        state["ifd"] = new_ifd
        state["inotify_meta"] = new_meta
        sock = state.get("sock")
        state["watch_fds"] = ([sock] if sock is not None else []) + (
            [new_ifd] if new_ifd >= 0 else []
        )

    cfg = load_config(cfg_file)
    perc, screen_on = read_screen_state(state["backlight_dir"])
    eff_level, state["current_auto_zone"] = compute_effective_state(
        cfg, perc, screen_on, state.get("current_auto_zone", -1)
    )

    if cfg.get("save_boot"):
        req_seq = int(cfg.get("save_boot_seq", 0)) or int(cfg.get("force_seq", 0))
        try:
            update_config_preserving_concurrent_edits(
                lambda latest: latest.update(
                    {
                        "save_boot_status": {
                            "seq": req_seq,
                            "state": "running",
                            "ok": None,
                        }
                    }
                ),
                path=cfg_file,
            )
        except OSError:
            pass

        boot_ok, state["zone_ids"] = hw_apply(
            state["hidraw_path"],
            eff_level,
            state.get("zone_ids"),
            config=cfg,
            save_boot=True,
        )

        def _finalize_boot_status(latest):
            # Only clear save_boot if no newer save_boot request arrived meanwhile
            if (int(latest.get("save_boot_seq", 0)) or int(latest.get("force_seq", 0))) == req_seq:
                latest["save_boot"] = False
            latest["save_boot_status"] = {
                "seq": req_seq,
                "state": "done",
                "ok": bool(boot_ok),
            }

        try:
            cfg = update_config_preserving_concurrent_edits(
                _finalize_boot_status, path=cfg_file
            )
        except OSError:
            pass
        state["last_sig"] = None
        perc, screen_on = read_screen_state(state["backlight_dir"])
        eff_level, state["current_auto_zone"] = compute_effective_state(
            cfg, perc, screen_on, state.get("current_auto_zone", -1)
        )

    new_sig = make_state_signature(cfg, eff_level)
    if new_sig != state.get("last_sig"):
        ok, state["zone_ids"] = hw_apply(
            state["hidraw_path"],
            eff_level,
            state.get("zone_ids"),
            config=cfg,
        )
        if ok:
            print(
                f"Sync: Screen {perc}% -> Keyboard {eff_level}% "
                f"(mode={cfg.get('mode')}, sync={cfg.get('sync_screen')})",
                flush=True,
            )
            state["last_sig"] = new_sig
    return cfg


def run_daemon():
    def handle_sig(_signum, _frame):
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    backlight_dir = resolve_backlight_dir()
    hidraw_path = resolve_hidraw_dev()
    zone_ids = None
    current_auto_zone = -1
    last_sig = None

    cfg = load_config()
    perc, screen_on = read_screen_state(backlight_dir)
    eff_level, current_auto_zone = compute_effective_state(
        cfg, perc, screen_on, current_auto_zone
    )
    ok, zone_ids = apply_zone_to_hardware(hidraw_path, eff_level, zone_ids, config=cfg)
    if ok:
        last_sig = make_state_signature(cfg, eff_level)

    if not ok:
        print(f"HID unavailable or write failed: {hidraw_path or 'device not found'}; existing permissions are required.", file=sys.stderr, flush=True)
    sock = open_netlink_uevent_socket()
    ifd, inotify_meta = open_inotify_watches(backlight_dir, return_meta=True)
    state = {
        "backlight_dir": backlight_dir,
        "hidraw_path": hidraw_path,
        "zone_ids": zone_ids,
        "current_auto_zone": current_auto_zone,
        "last_sig": last_sig,
        "ifd": ifd,
        "inotify_meta": inotify_meta,
        "sock": sock,
        "watch_fds": [sock] + ([ifd] if ifd >= 0 else []),
    }

    print(
        f"Dell G15 Ambient Sync started (Direct HID: {hidraw_path or 'waiting'}, "
        f"Backlight: {backlight_dir or 'default'}, Initial: {perc}% -> Keyboard {eff_level}%)",
        flush=True,
    )

    pending_sync = bool(cfg.get("save_boot"))
    pending_rebind = False
    pending_bl_rebind = False

    try:
        while True:
            timeout = (
                DEBOUNCE_SEC
                if (pending_sync or pending_rebind or pending_bl_rebind)
                else None
            )
            readable, _, _ = select.select(state["watch_fds"], [], [], timeout)

            if readable:
                for rfd in readable:
                    if rfd is sock:
                        while True:
                            try:
                                datagram = sock.recv(4096)
                            except BlockingIOError:
                                break
                            kind = parse_relevant_uevent(datagram)
                            if kind == "backlight_rebind":
                                pending_bl_rebind = True
                                pending_sync = True
                            elif kind == "backlight":
                                pending_sync = True
                            elif kind == "hidraw":
                                pending_rebind = True
                                pending_sync = True
                    elif rfd == state["ifd"]:
                        try:
                            raw_ev = os.read(state["ifd"], 4096)
                            _ev_list, invalidated = parse_inotify_events(raw_ev)
                            if invalidated:
                                pending_bl_rebind = True
                        except OSError:
                            pending_bl_rebind = True
                        pending_sync = True
                continue

            if pending_sync or pending_rebind or pending_bl_rebind:
                process_daemon_sync_step(
                    state,
                    pending_rebind=pending_rebind,
                    pending_bl_rebind=pending_bl_rebind,
                )
                pending_sync = False
                pending_rebind = False
                pending_bl_rebind = False
    except SystemExit:
        pass
    finally:
        sock.close()
        if state.get("ifd", -1) >= 0:
            try:
                os.close(state["ifd"])
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(run_daemon() or 0)
